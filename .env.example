# Step 1: Get your API key from https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your-api-key-here

# Step 2: Get your Project ID from the URL at https://dataplatform.cloud.ibm.com
# It looks like: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WATSONX_PROJECT_ID=your-project-id-here

# Step 3: Use this URL (us-south is the default free tier region)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
